# PostgreSQL
POSTGRES_DB=stock_market
POSTGRES_USER=stock_market
POSTGRES_PASSWORD=stock_market

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=stock_market
RABBITMQ_DEFAULT_PASS=stock_market

# Backend service ports
AUTH_SERVICE_PORT=8081
MARKET_SERVICE_PORT=8082
PORTFOLIO_SERVICE_PORT=8083

# Frontend integration
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Authentication
# Use at least 32 bytes for HS256.
JWT_SECRET=change-this-demo-secret-key-with-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600

# Part 1 virtual account
INITIAL_BALANCE=100000.00
